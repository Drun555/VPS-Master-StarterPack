# Address used by the embedded HTTP server.
LISTEN_ADDRESS=0.0.0.0
PORT=42345

# Public URL of the external HTTPS reverse proxy, without a trailing slash.
BASE_URL=https://example.org

# Shared Let's Encrypt account email passed to every Slave setup.
CERTBOT_EMAIL=admin@example.org

# Optional override for development or a fork of the Slave repository.
SLAVE_SETUP_URL=https://raw.githubusercontent.com/Drun555/VPS-Slave-StarterPack/main/setup.sh
